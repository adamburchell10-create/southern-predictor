# Supabase project settings (Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Name of the league shown in the app
LEAGUE_NAME="Southern League - Division One Central"

# The footballwebpages.co.uk slug for the competition
LEAGUE_SLUG=southern-football-league-division-one-central

# A long random secret only you and GitHub Actions know.
# Generate one with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string
